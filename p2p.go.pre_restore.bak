			if sub != nil {
				sub.Cancel()
			}
		}()

		if DebugNet {
			fmt.Println("âœ… Listening for proposals...")
		}

		// =====================================================
		// ðŸ”„ MESSAGE PROCESSING LOOP
		// =====================================================
		for {
			select {
			case <-ctx.Done():
				if DebugNet {
					fmt.Println("ðŸ›‘ Proposal listener stopped")
				}
				return

			case <-n.shutdownCh:
				if DebugNet {
					fmt.Println("ðŸ›‘ Proposal listener (shutdown)")
				}
				return

			default:
				// =================================================
				// ðŸ“¨ RECEIVE MESSAGE
				// =================================================
				msg, err := sub.Next(ctx)
				if err != nil {
					if err == context.Canceled {
						return
					}
					if DebugNet {
						fmt.Printf("âš ï¸ Proposal subscription error: %v\n", err)
