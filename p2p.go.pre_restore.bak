func (n *Node) setupProtocols() {
	// Block sync protocol
	n.Host.SetStreamHandler("/msc/blocksync/1.0.0", n.handleBlockStream)
	// Consensus stream
	n.Host.SetStreamHandler("/msc/consensus/1.0.0", n.handleConsensusStream)
	// Peer info exchange
	n.Host.SetStreamHandler("/msc/peerinfo/1.0.0", n.handlePeerInfoStream)
	// Ping protocol (already enabled in libp2p.New)
	if DebugNet {
		fmt.Println("ðŸ”§ Network protocols configured")
	}
}
func (n *Node) handleConsensusStream(s network.Stream) {
	defer s.Close()
	// =====================================================
	// â±ï¸ SET TIMEOUTS FOR NETWORK OPERATIONS
	// =====================================================
	deadline := time.Now().Add(120 * time.Second) // Longer timeout for consensus
	s.SetDeadline(deadline)
	s.SetReadDeadline(deadline)
	s.SetWriteDeadline(deadline)
	// =====================================================
	// ðŸ“– SETUP READER/WRITER WITH BUFFERING
	// =====================================================
	reader := bufio.NewReaderSize(s, 65536) // 64KB buffer
	writer := bufio.NewWriterSize(s, 65536)
	defer writer.Flush()
	// =====================================================
	// ðŸ”„ PROCESSING LOOP
	// =====================================================
	for {
		// =================================================
		// ðŸ“¨ READ MESSAGE WITH NEWLINE DELIMITER
		// =================================================
		line, err := reader.ReadString('\n')
		if err != nil {
			if err == io.EOF {
				if DebugNet {
					fmt.Printf("ðŸ”Œ Consensus stream EOF from %s\n", s.Conn().RemotePeer())
				}
			} else if !strings.Contains(err.Error(), "closed") {
				if DebugNet {
					fmt.Printf("âš ï¸ Consensus stream read error from %s: %v\n",
						s.Conn().RemotePeer(), err)
				}
			}
			break
		}
		// =================================================
		// ðŸ§© PARSE JSON MESSAGE
		// =================================================
		line = strings.TrimSpace(line)
		if line == "" {
			continue
		}
		var msg Message
		if err := json.Unmarshal([]byte(line), &msg); err != nil {
			if DebugNet {
				fmt.Printf("âš ï¸ Invalid JSON from %s: %v\n",
					s.Conn().RemotePeer(), err)
				fmt.Printf("   Raw: %s\n", line[:min(100, len(line))])
			}
			// Send error response
			errorResp := Message{
				Type: "error",
				Data: []byte(fmt.Sprintf(`{"error":"invalid_json","message":"%v"}`, err)),
			}
			respData, _ := json.Marshal(errorResp)
			writer.Write(append(respData, '\n'))
			writer.Flush()
			continue
		}
		// =================================================
		// ðŸŽ¯ VALIDATE MESSAGE TYPE
		// =================================================
		if msg.Type == "" {
			if DebugNet {
				fmt.Printf("âš ï¸ Empty message type from %s\n", s.Conn().RemotePeer())
			}
			continue
		}
		// =================================================
		// ðŸ“Š DEBUG LOGGING
		// =================================================
		if DebugConsensus {
			fmt.Printf("ðŸ“¨ Consensus message from %s: %s (size: %d bytes)\n",
				s.Conn().RemotePeer(), msg.Type, len(msg.Data))
			// Log specific message types in detail
			switch msg.Type {
			/* legacy consensus removed: proposals/votes
			case MsgProposeBlock:
				var block Block
				if err := json.Unmarshal(msg.Data, &block); err == nil {
					fmt.Printf("   Block proposal: height=%d proposer=%s\n",
						block.ID, ShortID(block.Proposer))
				}
			case MsgBlockVote:
				var vote BlockVote
				if err := json.Unmarshal(msg.Data, &vote); err == nil {
					fmt.Printf("   Block vote: height=%d validator=%s\n",
						vote.Height, ShortID(vote.Validator))
				}
			*/
			case MsgPeerHello:
				var hello PeerHello
				if err := json.Unmarshal(msg.Data, &hello); err == nil {
					fmt.Printf("   Peer hello: validator=%s\n", ShortID(hello.ValidatorID))
				}
			}
		}
		// =================================================
		// ðŸš€ PROCESS MESSAGE
		// =================================================
		n.handleMessage(msg, s.Conn().RemotePeer().String())
		// =================================================
		// ðŸ“¤ SEND ACKNOWLEDGEMENT
		// =================================================
		ack := Message{
			Type: "ack",
			Data: []byte(fmt.Sprintf(`{"type":"%s","status":"processed"}`, msg.Type)),
		}
		ackData, _ := json.Marshal(ack)
		if _, err := writer.Write(append(ackData, '\n')); err != nil {
			if DebugNet {
				fmt.Printf("âš ï¸ Failed to send ack to %s: %v\n",
					s.Conn().RemotePeer(), err)
			}
			break
		}
		// Flush periodically to ensure delivery
		if err := writer.Flush(); err != nil {
			if DebugNet {
				fmt.Printf("âš ï¸ Stream flush error to %s: %v\n",
					s.Conn().RemotePeer(), err)
			}
			break
		}
		// =================================================
		// ðŸ”„ RESET DEADLINE FOR NEXT MESSAGE
		// =================================================
		newDeadline := time.Now().Add(30 * time.Second)
		s.SetDeadline(newDeadline)
		s.SetReadDeadline(newDeadline)
		s.SetWriteDeadline(newDeadline)
	}
	// =====================================================
	// ðŸ“Š FINAL LOGGING
	// =====================================================
	if DebugNet {
		fmt.Printf("ðŸ”Œ Consensus stream closed with %s\n", s.Conn().RemotePeer())
	}
}
func (n *Node) joinGossipTopics() {
	ctx := context.Background()
	// Block topic
	blockTopic := "msc-blocks"
	blockSub, err := n.PubSub.Subscribe(blockTopic)
	if err == nil {
		go n.handleBlockGossip(blockSub)
	}
	// Transaction topic
	txTopic := "msc-transactions"
	txSub, err := n.PubSub.Subscribe(txTopic)
	if err == nil {
		go n.handleTransactionGossip(txSub)
	}
	// Validator gossip topic
	valTopic := "msc-validators"
	valSub, err := n.PubSub.Subscribe(valTopic)
	if err == nil {
		go n.handleValidatorGossip(valSub)
	}
	// Join topics (these don't return errors in Join)
	n.BlockTopic, _ = n.PubSub.Join("msc-blocks")
	n.TxTopic, _ = n.PubSub.Join("msc-tx")
	// Subscribe to topics
	// go n.listenVotes(ctx)
	go n.listenBlocks(ctx)
	go n.listenTx(ctx)
}
func (n *Node) listenBlocks(ctx context.Context) {
	// =====================================================
	// ðŸ“¡ SUBSCRIPTION INITIALIZATION
	// =====================================================
	var sub *pubsub.Subscription
	var err error
	// Try BlockTopic first
	if n.BlockTopic != nil {
		sub, err = n.BlockTopic.Subscribe(
			pubsub.WithBufferSize(1024),
		)
		if err != nil && DebugNet {
			fmt.Printf("âŒ BlockTopic subscribe failed: %v\n", err)
		}
	}
	// Fallback to direct PubSub subscription
	if sub == nil {
		sub, err = n.PubSub.Subscribe("msc-blocks")
		if err != nil {
			if DebugNet {
				fmt.Printf("âŒ Failed to subscribe to blocks: %v\n", err)
			}
			return
		}
	}
	defer func() {
		if sub != nil {
			sub.Cancel()
			if DebugNet {
				fmt.Println("ðŸ›‘ Block listener stopped")
			}
		}
	}()
	if DebugNet {
		fmt.Println("âœ… Listening for blocks...")
	}
	// =====================================================
	// ðŸ“Š METRICS AND STATE
	// =====================================================
	var (
		blockCount  int
		lastLogTime = time.Now()
		seenBlockMu sync.RWMutex
		seenBlocks  = make(map[string]time.Time)
		lastHeight  uint64
		heightJumps int
	)
	// Cleanup goroutine for seen blocks cache
	go func() {
		ticker := time.NewTicker(10 * time.Minute)
		defer ticker.Stop()
		for {
			select {
			case <-ctx.Done():
				return
			case <-n.shutdownCh:
				return
			case <-ticker.C:
				seenBlockMu.Lock()
				now := time.Now()
				for hash, seenTime := range seenBlocks {
					if now.Sub(seenTime) > 30*time.Minute {
						delete(seenBlocks, hash)
					}
				}
				seenBlockMu.Unlock()
			}
		}
	}()
	// =====================================================
	// ðŸ”„ PROCESSING LOOP
	// =====================================================
	for {
		select {
		case <-ctx.Done():
			if DebugNet {
				fmt.Printf("ðŸ›‘ Block listener stopped (context): %v\n", ctx.Err())
			}
			return
		case <-n.shutdownCh:
			if DebugNet {
				fmt.Println("ðŸ›‘ Block listener (shutdown)")
			}
			return
		default:
			// =================================================
			// ðŸ“¨ RECEIVE MESSAGE
			// =================================================
			msg, err := sub.Next(ctx)
			if err != nil {
				if err == context.Canceled {
					return
				}
				if DebugNet {
					fmt.Printf("âš ï¸ Block subscription error: %v\n", err)
				}
				time.Sleep(500 * time.Millisecond) // Longer delay for blocks
				continue
			}
			// =================================================
			// ðŸ™… SELF-MESSAGE FILTERING
			// =================================================
			if msg.ReceivedFrom == n.Host.ID() {
				continue
			}
			// Ignore non-JSON payloads (e.g., pubsub mesh keepalive)
			if len(msg.Data) == 0 || msg.Data[0] != '{' {
				continue
			}
			// =================================================
			// ðŸ§© MESSAGE PARSING
			// =================================================
			var block Block
			var parseErr error
			// Try Message wrapper format first
			var m Message
			if err := json.Unmarshal(msg.Data, &m); err == nil && m.Type != "" {
				if m.Type == MsgLeaderBlock {
					var leader Block
					if err := json.Unmarshal(m.Data, &leader); err == nil {
						n.handleLeaderBlock(leader)
					}
					continue
				}
				if m.Type == MsgBlock {
					parseErr = json.Unmarshal(m.Data, &block)
				} else {
					continue
				}
			} else {
				// Try direct Block format
				parseErr = json.Unmarshal(msg.Data, &block)
			}
			if parseErr != nil {
				if DebugNet {
					fmt.Printf("âš ï¸ Failed to parse block: %v\n", parseErr)
					if len(msg.Data) < 500 {
						fmt.Printf("   Raw data (first 500 chars): %.500s\n", string(msg.Data))
					}
				}
				continue
			}
			// =================================================
			// ðŸŽ¯ BASIC VALIDATION
			// =================================================
			if block.ID == 0 || block.BlockHash == "" || block.PrevHash == "" {
				if DebugNet {
					fmt.Println("âš ï¸ Invalid block: missing required fields")
				}
				continue
			}
			// Check for height jumps (possible fork or sync)
			if lastHeight > 0 && block.ID > lastHeight+1 {
				heightJumps++
				if DebugSync {
					fmt.Printf("âš ï¸ Height jump detected: %d -> %d (gap: %d)\n",
						lastHeight, block.ID, block.ID-lastHeight-1)
				}
			}
			lastHeight = block.ID
			// =================================================
			// ðŸ”„ DEDUPLICATION
			// =================================================
			seenBlockMu.RLock()
			seenTime, exists := seenBlocks[block.BlockHash]
			seenBlockMu.RUnlock()
			if exists && time.Since(seenTime) < 5*time.Minute {
				if DebugConsensus {
					fmt.Printf("â­ï¸ Duplicate block ignored: height=%d hash=%s\n",
						block.ID, block.BlockHash[:8])
				}
				continue
			}
			seenBlockMu.Lock()
			seenBlocks[block.BlockHash] = time.Now()
			seenBlockMu.Unlock()
			// =================================================
			// ðŸ“Š DEBUG LOGGING
			// =================================================
			blockCount++
			if DebugConsensus {
				// Log every block in detail
				fmt.Printf("ðŸ“¦ Block received | height=%d type=%s proposer=%s from=%s\n",
					block.ID,
					block.Type,
					ShortID(block.Proposer),
					msg.ReceivedFrom)
				// Additional info for work blocks
				if block.Type == BlockTypeWork && len(block.Transactions) > 0 {
					fmt.Printf("   TX count: %d, Mempool root: %s\n",
						len(block.Transactions), block.MempoolRoot[:8])
				}
				// Periodic summary
				if blockCount%100 == 0 || time.Since(lastLogTime) > 30*time.Second {
					fmt.Printf("ðŸ“Š Block stats: Received %d blocks, height jumps: %d\n",
						blockCount, heightJumps)
					lastLogTime = time.Now()
				}
			}
			// =================================================
			// ðŸš€ PROCESS BLOCK
			// =================================================
			n.ReceiveBlock(block, n.Blockchain)
			n.ProcessQueuedBlocks()
			// =================================================
			// â¸ï¸ THROTTLING (blocks are less frequent than TXs)
			// =================================================
			// Small delay to allow other goroutines to run
			time.Sleep(50 * time.Millisecond)
		}
	}
}
func (n *Node) listenTx(ctx context.Context) {
	// =====================================================
	// ðŸ“¡ SUBSCRIPTION INITIALIZATION
	// =====================================================
	var sub *pubsub.Subscription
	var err error
	// Try TxTopic first, fallback to PubSub
	if n.TxTopic != nil {
		sub, err = n.TxTopic.Subscribe(
			pubsub.WithBufferSize(2048), // Larger buffer for TX flood
		)
		if err != nil && DebugNet {
			fmt.Printf("âŒ TxTopic subscribe failed: %v\n", err)
		}
	}
	if sub == nil {
		// Fallback to direct PubSub subscription
		sub, err = n.PubSub.Subscribe("msc-transactions")
		if err != nil {
			if DebugNet {
				fmt.Printf("âŒ Failed to subscribe to transactions: %v\n", err)
			}
			return
		}
	}
	defer func() {
		if sub != nil {
			sub.Cancel()
			if DebugNet {
				fmt.Println("ðŸ›‘ TX listener stopped")
			}
		}
	}()
	if DebugNet {
		fmt.Println("âœ… Listening for transactions...")
	}
	// =====================================================
	// ðŸ“Š METRICS AND RATE LIMITING
	// =====================================================
	var (
		txCount      int
		lastLogTime  = time.Now()
		rateLimiter  = rate.NewLimiter(rate.Every(time.Second), 1000) // 1000 TX/sec
		seenTxCache  = make(map[string]time.Time)
		cacheCleanup = time.NewTicker(5 * time.Minute)
	)
	defer cacheCleanup.Stop()
	// =====================================================
	// ðŸ”„ PROCESSING LOOP
	// =====================================================
	for {
		select {
		case <-ctx.Done():
			if DebugNet {
				fmt.Printf("ðŸ›‘ TX listener stopped (context): %v\n", ctx.Err())
			}
			return
		case <-n.shutdownCh:
			if DebugNet {
				fmt.Println("ðŸ›‘ TX listener (shutdown)")
			}
			return
		case <-cacheCleanup.C:
			// Clean old entries from cache
			now := time.Now()
			for txID, seenTime := range seenTxCache {
				if now.Sub(seenTime) > 10*time.Minute {
					delete(seenTxCache, txID)
				}
			}
		default:
			// =================================================
			// ðŸ“¨ RECEIVE MESSAGE
			// =================================================
			msg, err := sub.Next(ctx)
			if err != nil {
				if err == context.Canceled {
					return
				}
				if DebugNet {
					fmt.Printf("âš ï¸ TX subscription error: %v\n", err)
				}
				time.Sleep(100 * time.Millisecond)
				continue
			}
			// =================================================
			// ðŸ™… SELF-MESSAGE FILTERING
			// =================================================
			if msg.ReceivedFrom == n.Host.ID() {
				if DebugConsensus {
					fmt.Println("â­ï¸ Ignoring self-published TX")
				}
				continue
			}
			// =================================================
			// â¸ï¸ RATE LIMITING
			// =================================================
			if !rateLimiter.Allow() {
				if DebugNet {
					fmt.Println("âš ï¸ TX rate limit exceeded, skipping")
				}
				continue
			}
			// =================================================
			// ðŸ§© MESSAGE PARSING (MULTI-FORMAT SUPPORT)
			// =================================================
			var tx Transaction
			var parseErr error
			// Try Message wrapper format first
			var m Message
			if err := json.Unmarshal(msg.Data, &m); err == nil && m.Type == MsgTx {
				parseErr = json.Unmarshal(m.Data, &tx)
			} else {
				// Try direct Transaction format
				parseErr = json.Unmarshal(msg.Data, &tx)
			}
			if parseErr != nil {
				if DebugNet {
					fmt.Printf("âš ï¸ Failed to parse transaction: %v\n", parseErr)
					if len(msg.Data) < 200 {
						fmt.Printf("   Raw data: %s\n", string(msg.Data))
					}
				}
				continue
			}
			// =================================================
			// ðŸŽ¯ BASIC VALIDATION
			// =================================================
			if tx.ID == "" || tx.From == "" || tx.To == "" {
				if DebugNet {
					fmt.Println("âš ï¸ Invalid transaction: missing required fields")
				}
				continue
			}
			if tx.Amount <= 0 || tx.Fee < 0 {
				if DebugNet {
					fmt.Printf("âš ï¸ Invalid transaction amounts: amount=%d fee=%d\n",
						tx.Amount, tx.Fee)
				}
				continue
			}
			// =================================================
			// ðŸ”„ DEDUPLICATION CACHE
			// =================================================
			now := time.Now()
			if seenTime, exists := seenTxCache[tx.ID]; exists {
				if now.Sub(seenTime) < 1*time.Minute {
					// Recently seen, skip
					if DebugConsensus {
						fmt.Printf("â­ï¸ Duplicate TX ignored (recent): %s\n", tx.ID[:8])
					}
					continue
				}
			}
			seenTxCache[tx.ID] = now
			// =================================================
			// ðŸ“Š DEBUG LOGGING (THROTTLED)
			// =================================================
			txCount++
			if DebugConsensus {
				// Log first few and then periodically
				if txCount <= 10 || txCount%100 == 0 || time.Since(lastLogTime) > 10*time.Second {
					fmt.Printf("ðŸ’¸ TX received | id=%s from=%s to=%s amount=%d fee=%d\n",
						tx.ID[:8],
						ShortID(tx.From),
						ShortID(tx.To),
						tx.Amount,
						tx.Fee)
					lastLogTime = time.Now()
				}
			}
			// =================================================
			// ðŸš€ PROCESS TRANSACTION
			// =================================================
			n.ReceiveTransaction(tx)
			// =================================================
			// ðŸ“ˆ PERIODIC STATS
			// =================================================
			if txCount%1000 == 0 && DebugNet {
				fmt.Printf("ðŸ“Š TX stats: Processed %d transactions\n", txCount)
			}
			// =================================================
			// â¸ï¸ SMALL DELAY FOR CPU BREATHER
			// =================================================
			time.Sleep(1 * time.Millisecond)
		}
	}
}

