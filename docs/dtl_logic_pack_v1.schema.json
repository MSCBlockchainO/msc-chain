{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://msc-chain.local/schemas/dtl_logic_pack_v1.schema.json",
  "title": "DTL Logic Pack v1",
  "type": "object",
  "required": [
    "version",
    "name",
    "abi",
    "storage",
    "methods",
    "limits"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
    },
    "abi": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/abiMethod"
      }
    },
    "storage": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/storageField"
      }
    },
    "methods": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/logicMethod"
      }
    },
    "limits": {
      "$ref": "#/$defs/limits"
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
    },
    "register": {
      "type": "string",
      "pattern": "^r([0-9]|[12][0-9]|3[01])$"
    },
    "typeName": {
      "type": "string",
      "enum": [
        "u64",
        "string",
        "bool",
        "address"
      ]
    },
    "abiArg": {
      "type": "object",
      "required": [
        "name",
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "#/$defs/identifier"
        },
        "type": {
          "$ref": "#/$defs/typeName"
        }
      }
    },
    "abiMethod": {
      "type": "object",
      "required": [
        "name",
        "args",
        "returns"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "#/$defs/identifier"
        },
        "args": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/abiArg"
          }
        },
        "returns": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/typeName"
          }
        }
      }
    },
    "storageField": {
      "type": "object",
      "required": [
        "key",
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "key": {
          "$ref": "#/$defs/identifier"
        },
        "type": {
          "type": "string",
          "enum": [
            "u64",
            "string",
            "bool"
          ]
        },
        "init": {
          "type": "string",
          "maxLength": 256
        }
      }
    },
    "limits": {
      "type": "object",
      "required": [
        "max_reads",
        "max_writes",
        "max_token_transfers"
      ],
      "additionalProperties": false,
      "properties": {
        "max_reads": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024
        },
        "max_writes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024
        },
        "max_token_transfers": {
          "type": "integer",
          "minimum": 0,
          "maximum": 128
        }
      }
    },
    "logicMethod": {
      "type": "object",
      "required": [
        "name",
        "max_steps",
        "ops"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "#/$defs/identifier"
        },
        "max_steps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "ops": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/op"
          }
        }
      }
    },
    "op": {
      "type": "object",
      "required": [
        "op"
      ],
      "additionalProperties": true,
      "properties": {
        "op": {
          "type": "string",
          "enum": [
            "ARG_U64",
            "ARG_STR",
            "LOAD_U64",
            "LOAD_STR",
            "STORE_U64",
            "STORE_STR",
            "ADD_U64",
            "SUB_U64",
            "MUL_U64",
            "DIV_U64",
            "CMP_EQ",
            "CMP_NEQ",
            "CMP_GT",
            "CMP_GTE",
            "CMP_LT",
            "CMP_LTE",
            "JMP_IF",
            "JMP",
            "ASSERT",
            "TOKEN_TRANSFER",
            "RET_OK",
            "RET_ERR"
          ]
        },
        "dest": {
          "$ref": "#/$defs/register"
        },
        "a": {
          "$ref": "#/$defs/register"
        },
        "b": {
          "$ref": "#/$defs/register"
        },
        "src": {
          "$ref": "#/$defs/register"
        },
        "cond": {
          "$ref": "#/$defs/register"
        },
        "key": {
          "$ref": "#/$defs/identifier"
        },
        "arg": {
          "$ref": "#/$defs/identifier"
        },
        "token_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "to_arg": {
          "$ref": "#/$defs/identifier"
        },
        "amount_arg": {
          "$ref": "#/$defs/identifier"
        },
        "from": {
          "type": "string",
          "enum": [
            "caller",
            "contract"
          ]
        },
        "message": {
          "type": "string",
          "maxLength": 256
        },
        "target": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        }
      }
    }
  }
}
