{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Grafana Datasource Provisioning",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "apiVersion",
    "datasources"
  ],
  "properties": {
    "apiVersion": {
      "type": "integer",
      "enum": [1]
    },
    "datasources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "type",
          "url"
        ],
        "properties": {
          "name": { "type": "string" },
          "uid": { "type": "string" },
          "type": { "type": "string" },
          "access": { "type": "string" },
          "url": { "type": "string" },
          "isDefault": { "type": "boolean" },
          "editable": { "type": "boolean" }
        },
        "additionalProperties": true
      }
    }
  }
}
