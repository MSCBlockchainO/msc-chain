	func (n *Node) listenProposals(ctx context.Context) {
		// Result-gossip consensus: proposals are ignored.
		if ResultGossipOnly {
			return
		}

		// =====================================================
		// ðŸ“¡ SUBSCRIPTION INITIALIZATION
		// =====================================================
		var sub *pubsub.Subscription
		var err error

		// Priority 1: Use ProposalTopic if available
		if n.ProposalTopic != nil {
			sub, err = n.ProposalTopic.Subscribe(
				pubsub.WithBufferSize(1024),
			)
			if err != nil {
				if DebugNet {
					fmt.Printf("âŒ ProposalTopic subscribe failed: %v\n", err)
				}
				// Fall through to PubSub
			}
		}

		// Priority 2: Fallback to direct PubSub subscription
		if sub == nil {
			sub, err = n.PubSub.Subscribe("msc-proposals")
			if err != nil {
				if DebugNet {
					fmt.Printf("âŒ Failed to subscribe to proposals: %v\n", err)
				}
				return
			}
		}

		defer func() {
			if sub != nil {
				sub.Cancel()
			}
		}()

		if DebugNet {
			fmt.Println("âœ… Listening for proposals...")
		}

		// =====================================================
		// ðŸ”„ MESSAGE PROCESSING LOOP
		// =====================================================
		for {
			select {
			case <-ctx.Done():
				if DebugNet {
					fmt.Println("ðŸ›‘ Proposal listener stopped")
				}
				return

			case <-n.shutdownCh:
				if DebugNet {
					fmt.Println("ðŸ›‘ Proposal listener (shutdown)")
				}
				return

			default:
				// =================================================
				// ðŸ“¨ RECEIVE MESSAGE
				// =================================================
				msg, err := sub.Next(ctx)
				if err != nil {
					if err == context.Canceled {
						return
					}
					if DebugNet {
						fmt.Printf("âš ï¸ Proposal subscription error: %v\n", err)
					}
					// Continue to next message
					time.Sleep(100 * time.Millisecond)
					continue
				}

				// =================================================
				// ðŸ™… SELF-MESSAGE FILTERING
				// =================================================
				if msg.ReceivedFrom == n.Host.ID() {
					if DebugConsensus {
						fmt.Println("â­ï¸ Ignoring self-proposal")
					}
					continue
				}

				// =================================================
				// ðŸ§© MESSAGE PARSING (MULTI-FORMAT SUPPORT)
				// =================================================
