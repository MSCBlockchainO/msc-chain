				}

				if parseErr != nil {
					if DebugNet {
						fmt.Printf("âš ï¸ Failed to parse proposal: %v\n", parseErr)
						fmt.Printf("   Raw data: %s\n", string(msg.Data)[:min(100, len(msg.Data))])
